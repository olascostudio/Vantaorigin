# Copy to .env and fill in. Everything that changes between a laptop,
# managed hosting and a VPS lives here — nothing provider-specific is in code.

NODE_ENV=development
PORT=8080

# Local docker-compose value; on Render/Neon/VPS, paste that server's URL.
DATABASE_URL=postgres://vanta:vanta@localhost:5432/vantaorigin

# Where the front end runs (used for CORS and the links inside emails).
APP_ORIGIN=http://localhost:5173

# --- storage -------------------------------------------------------------
# memory = keep uploads in the process (local only, no account needed)
# s3     = any S3-compatible storage: Cloudflare R2 now, MinIO on a VPS later
STORAGE_DRIVER=memory
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=vantaorigin
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://media.vantaorigin.com

# --- email ---------------------------------------------------------------
# console = print emails to the terminal (local only)
# resend  = send for real
EMAIL_DRIVER=console
# RESEND_API_KEY=
EMAIL_FROM=VantaOrigin <noreply@vantaorigin.com>

SESSION_TTL_DAYS=30
