{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "studio.vantaorigin.com"
        }
      ],
      "destination": "/marketplace",
      "permanent": false
    },
    {
      "source": "/:path((?!marketplace|assets/)[^.]*)",
      "has": [
        {
          "type": "host",
          "value": "studio.vantaorigin.com"
        }
      ],
      "destination": "https://vantaorigin.com/:path",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
